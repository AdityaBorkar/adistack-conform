{
	"name": "adistack-conform",
	"version": "0.1.0",
	"bin": {
		"adistack-conform": "./.output/adistack-conform"
	},
	"files": [
		".output",
		"package.json",
		"configuration_schema.json",
		"README.md"
	],
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "bun gen:json-schema && bun build src/index.ts --compile --outfile .output/adistack-conform",
		"check:lint": "oxlint",
		"check:types": "tsrs",
		"clean": "bunx rimraf --glob \"**/{node_modules,dist,bun.lockb}\"",
		"dev": "bun ./src/index.ts",
		"format": "oxfmt",
		"gen:json-schema": "",
		"prepare": "husky",
		"verify": "bun format && bun check:lint && bun check:types && bun run build"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"commander": "15.0.0",
		"diff": "9.0.0",
		"env-paths": "4.0.0",
		"es-toolkit": "1.53.0",
		"execa": "10.2.1",
		"fast-deep-equal": "3.1.3",
		"fs-extra": "11.4.1",
		"json-pointer": "0.6.2",
		"picocolors": "1.1.1",
		"tar": "7.5.22",
		"tinyglobby": "0.2.17",
		"untildify": "6.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/bun": "1.4.4",
		"@types/diff": "7.0.2",
		"@types/fs-extra": "11.0.4",
		"@types/json-pointer": "1.0.34",
		"@types/node": "26.6.5",
		"bun-types": "1.4.4",
		"husky": "9.1.7",
		"knip": "6.43.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "7.0.2"
	}
}
