{
	"name": "@adistack/conform",
	"version": "0.1.0",
	"description": "CLI that checks project files, machine state, and GitHub repo settings against tech-stack blueprints",
	"keywords": [
		"check",
		"conform"
	],
	"homepage": "https://github.com/AdityaBorkar/adistack-conform#readme",
	"bugs": "https://github.com/AdityaBorkar/adistack-conform/issues",
	"license": "MIT",
	"author": {
		"name": "Aditya Borkar",
		"email": "hello@adityab.tech",
		"url": "https://adityab.tech"
	},
	"maintainers": [
		{
			"email": "hello@adityab.tech",
			"name": "Aditya Borkar",
			"url": "https://adityab.tech"
		}
	],
	"contributors": [
		{
			"email": "hello@adityab.tech",
			"name": "Aditya Borkar",
			"url": "https://adityab.tech"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AdityaBorkar/adistack-conform.git"
	},
	"bin": {
		"@adistack/conform": "./.output/adistack-conform"
	},
	"files": [
		".output",
		"src",
		"package.json",
		"configuration_schema",
		"README.md",
		"skills",
		"docs/www"
	],
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "bun ./scripts/build.ts",
		"check:lint": "oxlint",
		"check:types": "tsrs",
		"clean": "bun rimraf --glob \"**/{node_modules,dist,bun.lockb}\"",
		"dev": "bun ./src/index.ts",
		"format": "oxfmt",
		"gen:json-schema": "bun ./scripts/generate-json-schema.ts",
		"prepare": "husky",
		"review:knip": "knip",
		"test": "bun test",
		"verify": "bun format && bun check:lint && bun check:types && bun test"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"commander": "15.1.0",
		"diff": "9.0.0",
		"picocolors": "1.1.1",
		"untildify": "6.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.6",
		"husky": "9.1.7",
		"knip": "6.44.1",
		"oxfmt": "0.76.0",
		"oxlint": "1.92.0",
		"rimraf": "6.1.4",
		"tsrs": "0.23.0-ts7.1.0-beta",
		"typescript": "7.0.2"
	},
	"peerDependencies": {}
}
