{
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. project-blueprint.json."
		},
		"description": {
			"type": "string",
			"description": "Human-readable blueprint description."
		},
		"exclude": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Preset names dropped from the effective set.",
			"default": []
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"description": "Display name for the project blueprint."
		},
		"presets": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Preset names included by this blueprint.",
			"default": []
		},
		"type": {
			"const": "project.blueprint",
			"description": "Discriminant for project blueprints."
		}
	},
	"required": ["name", "type"],
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
