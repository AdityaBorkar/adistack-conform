{
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. ./configuration_schema/machine.json."
		},
		"blueprint": {
			"type": "string",
			"minLength": 1,
			"description": "Machine blueprint name, e.g. main."
		},
		"exclude": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Preset names dropped from the effective set.",
			"default": []
		},
		"presets": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Extra preset names merged over the blueprint.",
			"default": []
		},
		"source": {
			"type": "object",
			"properties": {
				"branch": {
					"type": "string",
					"minLength": 1,
					"description": "Git branch of the tech-stack repo (defaults to ref)."
				},
				"ref": {
					"type": "string",
					"minLength": 1,
					"description": "Git branch, tag, or commit.",
					"default": "main"
				},
				"repo": {
					"type": "string",
					"pattern": "^[^/\\s]+\\/[^/\\s]+$",
					"description": "GitHub owner/repo holding blueprints and presets."
				},
				"type": {
					"const": "github",
					"description": "Preset source; only github is supported."
				}
			},
			"required": ["repo", "type"],
			"description": "Tech-stack repo holding blueprints and presets."
		}
	},
	"required": ["blueprint", "source"],
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
