{
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. machine-preset.json."
		},
		"packages": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"files": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"name": {
									"type": "string",
									"minLength": 1,
									"description": "File name within the preset."
								},
								"path": {
									"type": "string",
									"minLength": 1,
									"description": "Repo-relative source path, e.g. machine/presets/git/gitconfig."
								},
								"target": {
									"type": "string",
									"minLength": 1,
									"description": "Enforcement target."
								}
							},
							"required": ["name", "path", "target"]
						},
						"minItems": 1,
						"description": "Files belonging to this preset."
					},
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Preset name."
					}
				},
				"required": ["files", "name"]
			},
			"description": "All machine presets."
		},
		"type": {
			"const": "machine.presets",
			"description": "Discriminant for the machine presets manifest."
		}
	},
	"required": ["packages", "type"],
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
