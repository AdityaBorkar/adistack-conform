{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. https://stack.adityab.tech/conform/<VERSION>/schemas/project-manifest.json."
		},
		"description": {
			"type": "string",
			"description": "Human-readable blueprint description."
		},
		"file_structure": {
			"default": [],
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"enum": ["dir", "file"],
						"description": "Required entry kind: dir must exist as a directory, file must exist as a file."
					},
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Entry name within the blueprint."
					},
					"target": {
						"type": "string",
						"minLength": 1,
						"description": "Enforcement target."
					}
				},
				"required": ["kind", "name", "target"],
				"additionalProperties": false
			},
			"description": "Existence-only entries enforced by this blueprint (no content compare)."
		},
		"files": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"compare": {
						"type": "object",
						"properties": {
							"ignore": {
								"default": [],
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								},
								"description": "Top-level keys excluded from the compare; local values are preserved by fix."
							},
							"strip": {
								"default": [],
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								},
								"description": "Top-level keys removed from both sides before comparing and from fix output."
							},
							"versioned": {
								"default": [],
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								},
								"description": "Object sections (e.g. dependencies) where versions must match for packages present on both sides; fix takes golden versions."
							}
						},
						"additionalProperties": false,
						"description": "Semantic compare/fix rules for this file."
					},
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "File name within the blueprint."
					},
					"source": {
						"type": "string",
						"minLength": 1,
						"description": "Repo-relative source path of the golden file (e.g. projects/files/<group>/<file>)."
					},
					"target": {
						"type": "string",
						"minLength": 1,
						"description": "Enforcement target."
					}
				},
				"required": ["name", "source", "target"],
				"additionalProperties": false
			},
			"description": "Files enforced by this blueprint."
		},
		"github": {
			"type": "string",
			"minLength": 1,
			"description": "Repo-relative source path of the GitHub settings preset."
		},
		"js": {
			"type": "object",
			"properties": {
				"dependencies": {
					"default": {},
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					},
					"description": "Packages required in dependencies, pinned to exact versions; \"any\" allows any installed version."
				},
				"devDependencies": {
					"default": {},
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					},
					"description": "Packages required in devDependencies, pinned to exact versions; \"any\" allows any installed version."
				},
				"peerDependencies": {
					"default": {},
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					},
					"description": "Packages required in peerDependencies, pinned to exact versions; \"any\" allows any installed version."
				},
				"pm": {
					"default": "bun",
					"type": "string",
					"minLength": 1,
					"description": "Package manager binary used in install hints, e.g. bun."
				}
			},
			"additionalProperties": false,
			"description": "JavaScript packages required in package.json."
		}
	},
	"required": ["files"],
	"additionalProperties": false
}
