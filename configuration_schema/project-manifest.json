{
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. https://stack.adityab.tech/conform/<VERSION>/schemas/project-manifest.json."
		},
		"description": {
			"type": "string",
			"description": "Human-readable blueprint description."
		},
		"directories": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Directory name within the blueprint."
					},
					"target": {
						"type": "string",
						"minLength": 1,
						"description": "Enforcement target."
					}
				},
				"required": ["name", "target"]
			},
			"description": "Directories enforced by this blueprint."
		},
		"files": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"compare": {
						"type": "object",
						"properties": {
							"ignore": {
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								},
								"description": "Top-level keys excluded from the compare; local values are preserved by fix.",
								"default": []
							},
							"pinned": {
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								},
								"description": "Top-level keys that must match the golden (objects merge per key, so local extras are allowed); fix takes golden values.",
								"default": []
							},
							"strip": {
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								},
								"description": "Top-level keys removed from both sides before comparing and from fix output.",
								"default": []
							},
							"versioned": {
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								},
								"description": "Object sections (e.g. dependencies) where versions must match for packages present on both sides; fix takes golden versions.",
								"default": []
							}
						},
						"required": [],
						"description": "Semantic compare/fix rules for this file."
					},
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "File name within the blueprint."
					},
					"source": {
						"type": "string",
						"minLength": 1,
						"description": "Source path of the golden file. Relative to the manifest directory when starting with ./ or ../, otherwise relative to the tech-stack root."
					},
					"target": {
						"type": "string",
						"minLength": 1,
						"description": "Enforcement target."
					}
				},
				"required": ["name", "source", "target"]
			},
			"description": "Files enforced by this blueprint."
		},
		"js": {
			"type": "object",
			"properties": {
				"dependencies": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Packages required in dependencies.",
					"default": []
				},
				"devDependencies": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Packages required in devDependencies.",
					"default": []
				},
				"peerDependencies": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Packages required in peerDependencies.",
					"default": []
				},
				"pm": {
					"type": "string",
					"minLength": 1,
					"description": "Package manager binary used in install hints, e.g. bun.",
					"default": "bun"
				}
			},
			"required": [],
			"description": "JavaScript packages required in package.json."
		},
		"required": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Paths that must exist; content is per-project (existence only)."
		}
	},
	"required": ["files"],
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
