{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. ./configuration_schema/github.json."
		},
		"actions": {
			"default": {},
			"type": "object",
			"properties": {
				"allowApprovePRs": {
					"default": false,
					"type": "boolean",
					"description": "Allow GitHub Actions to create and approve pull requests."
				},
				"allowed": {
					"default": "all",
					"type": "string",
					"enum": ["all", "local-only", "selected"],
					"description": "Which actions and reusable workflows may run."
				},
				"approvalForExternal": {
					"default": true,
					"type": "boolean",
					"description": "Require approval for all external contributors (fork PR workflows)."
				},
				"defaultWorkflowPermissions": {
					"default": "read",
					"type": "string",
					"enum": ["read", "write"],
					"description": "Default GITHUB_TOKEN permissions."
				},
				"oidcImmutableSubject": {
					"default": true,
					"type": "boolean",
					"description": "Use the immutable subject claim for OIDC. Check-only: no public fix API."
				},
				"retentionDays": {
					"default": 90,
					"type": "integer",
					"minimum": 1,
					"maximum": 9007199254740991,
					"description": "Artifact and log retention in days."
				},
				"shaPinningRequired": {
					"default": true,
					"type": "boolean",
					"description": "Require actions to be pinned to a full-length commit SHA."
				}
			},
			"description": "GitHub Actions permissions and retention."
		},
		"agentSuggestions": {
			"default": "full-control",
			"type": "string",
			"enum": ["full-control", "disabled"],
			"description": "Agent suggestions for issues. Check-only: no public API, verify in the UI."
		},
		"archiveSettings": {
			"default": {},
			"type": "object",
			"properties": {
				"commitComments": {
					"default": false,
					"type": "boolean",
					"description": "Allow comments on individual commits."
				},
				"includeLfsInArchives": {
					"default": false,
					"type": "boolean",
					"description": "Include Git LFS objects in archives."
				},
				"pushUpdateLimit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9007199254740991,
					"description": "Max branches/tags updated in a single push. Omit to skip (no public API)."
				}
			},
			"description": "Repo archive/push toggles. Check-only: no public API, verify in Settings."
		},
		"checks": {
			"default": ["conform", "format", "lint", "types"],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Required status check contexts on the default branch."
		},
		"codeowners": {
			"type": "string",
			"minLength": 1,
			"description": "Required CODEOWNERS path, e.g. .github/CODEOWNERS. Omit to skip the presence check."
		},
		"defaultBranch": {
			"default": "stable",
			"type": "string",
			"minLength": 1,
			"description": "Default branch name."
		},
		"environments": {
			"default": ["beta", "stable"],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Deployment environments that must exist (created by fix when missing)."
		},
		"features": {
			"default": {},
			"type": "object",
			"properties": {
				"discussions": {
					"default": false,
					"type": "boolean"
				},
				"issueTemplates": {
					"default": true,
					"type": "boolean",
					"description": "Require .github/ISSUE_TEMPLATE content."
				},
				"issues": {
					"default": true,
					"type": "boolean"
				},
				"projects": {
					"default": false,
					"type": "boolean"
				},
				"wiki": {
					"default": false,
					"type": "boolean"
				}
			},
			"description": "Repo feature toggles."
		},
		"merge": {
			"default": {},
			"type": "object",
			"properties": {
				"autoMerge": {
					"default": true,
					"type": "boolean"
				},
				"deleteHeadBranches": {
					"default": true,
					"type": "boolean",
					"description": "Automatically delete head branches."
				},
				"mergeCommit": {
					"default": true,
					"type": "boolean"
				},
				"mergeMessage": {
					"default": "pr-body",
					"type": "string",
					"enum": ["blank", "pr-body", "pr-title"]
				},
				"mergeTitle": {
					"default": "pr-title",
					"type": "string",
					"enum": ["merge-message", "pr-title"]
				},
				"rebaseMerge": {
					"default": false,
					"type": "boolean"
				},
				"squashMerge": {
					"default": true,
					"type": "boolean"
				},
				"squashMessage": {
					"default": "pr-body",
					"type": "string",
					"enum": ["blank", "commit-messages", "pr-body"]
				},
				"squashTitle": {
					"default": "pr-title",
					"type": "string",
					"enum": ["commit-title", "pr-title"]
				}
			},
			"description": "Merge methods, commit message defaults, and PR automation."
		},
		"releasesImmutable": {
			"default": true,
			"type": "boolean",
			"description": "Disallow modifying release assets and tags."
		},
		"reviews": {
			"default": {},
			"type": "object",
			"properties": {
				"dismissStale": {
					"default": true,
					"type": "boolean"
				},
				"requireCodeOwner": {
					"default": true,
					"type": "boolean"
				},
				"requireConversationResolution": {
					"default": true,
					"type": "boolean"
				},
				"requireSignedCommits": {
					"default": false,
					"type": "boolean"
				},
				"requiredApprovals": {
					"default": 1,
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"restrictPushes": {
					"default": true,
					"type": "boolean",
					"description": "Limit pushes to users explicitly granted read or higher access."
				}
			},
			"description": "Default-branch code review and push restrictions."
		},
		"rulesets": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Ruleset names that must exist and be active. Fix is manual (author JSON in the UI)."
		},
		"secrets": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Required Actions secret names (presence only; values are write-only)."
		},
		"security": {
			"default": {},
			"type": "object",
			"properties": {
				"copilotAutofix": {
					"default": false,
					"type": "boolean",
					"description": "Copilot Autofix. Check-only: no public API, verify in the UI."
				},
				"dependabot": {
					"default": true,
					"type": "boolean",
					"description": "Dependabot security updates."
				},
				"dependencyAutoSubmit": {
					"default": true,
					"type": "boolean"
				},
				"dependencyGraph": {
					"default": true,
					"type": "boolean"
				},
				"privateVulnerabilityReporting": {
					"default": true,
					"type": "boolean"
				},
				"pushProtection": {
					"default": true,
					"type": "boolean"
				},
				"secretProtection": {
					"default": true,
					"type": "boolean"
				}
			},
			"description": "Advanced Security toggles."
		},
		"signoffRequired": {
			"default": false,
			"type": "boolean",
			"description": "Require contributors to sign off on web-based commits."
		},
		"socialPreview": {
			"default": true,
			"type": "boolean",
			"description": "Custom social preview image is set. Check-only: no public API, upload in Settings."
		},
		"variables": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Required Actions variable names (presence only)."
		}
	}
}
