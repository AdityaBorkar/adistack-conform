{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. https://stack.adityab.tech/conform/<VERSION>/schemas/registry.json."
		},
		"github_configs": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			},
			"description": "GitHub settings blueprints as key/path entries."
		},
		"machines": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Display name for the blueprint."
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"description": "Machine flake directory relative to the tech-stack root (e.g. ./machines/main/)."
					}
				},
				"required": ["name", "path"],
				"additionalProperties": false
			},
			"description": "Machine blueprints as key/entry pairs."
		},
		"projects": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			},
			"description": "Project blueprints as key/path entries."
		}
	},
	"required": ["github_configs", "machines", "projects"],
	"additionalProperties": false
}
