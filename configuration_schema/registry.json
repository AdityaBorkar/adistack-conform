{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. https://stack.adityab.tech/conform/<VERSION>/schemas/registry.json."
		},
		"machines": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Display name for the blueprint."
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"description": "Blueprint directory relative to the tech-stack root, e.g. ./projects/cli-app/."
					}
				},
				"required": ["name", "path"]
			},
			"description": "Machine blueprints as explicit name/path entries."
		},
		"projects": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Display name for the blueprint."
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"description": "Blueprint directory relative to the tech-stack root, e.g. ./projects/cli-app/."
					}
				},
				"required": ["name", "path"]
			},
			"description": "Project blueprints as explicit name/path entries."
		}
	},
	"required": ["machines", "projects"]
}
