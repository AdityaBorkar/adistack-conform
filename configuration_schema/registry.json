{
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema reference, e.g. registry.json."
		},
		"machine": {
			"type": "object",
			"properties": {
				"blueprints": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Blueprint locations relative to tech-stack root."
				},
				"presets": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Preset locations relative to tech-stack root."
				}
			},
			"required": ["blueprints", "presets"],
			"description": "Machine blueprints and presets locations."
		},
		"project": {
			"type": "object",
			"properties": {
				"blueprints": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Blueprint locations relative to tech-stack root."
				},
				"presets": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Preset locations relative to tech-stack root."
				}
			},
			"required": ["blueprints", "presets"],
			"description": "Project blueprints and presets locations."
		}
	},
	"required": ["machine", "project"],
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
